# Copy to .env at the repo root. Never commit .env, never log its values.
#
# Person C needs ONLY the two STEDI_ lines to run `npm run stedi:probe`.
# config.ts validates lazily, so missing MEDPLUM_/DEEPGRAM_ keys will not
# block the probe at 9:30.

# --- Stedi (C) -------------------------------------------------------
# Generate a TEST-mode key in the Stedi portal, not a production one.
# Any non-empty value works against the local mock server.
STEDI_API_KEY=local-mock-key
STEDI_TEST_MODE=true

# NO TEST KEY? Run `npm run stedi:mock` and uncomment the line below. The
# real request path, parser, and error handling all still run — responses
# come back flagged stubbed:true automatically. Delete the line to go live.
STEDI_BASE_URL=http://localhost:3100

# --- Medplum (B) -----------------------------------------------------
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
MEDPLUM_BASE_URL=https://api.medplum.com/

# --- Deepgram (A) ----------------------------------------------------
DEEPGRAM_API_KEY=

PORT=3000
