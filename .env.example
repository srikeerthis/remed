# Copy to .env at the repo root. Never commit .env or log its values.
PORT=3000

# --- Medplum (Person B) ---------------------------------------------
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
MEDPLUM_BASE_URL=https://api.medplum.com/

# --- Deepgram (Person A) --------------------------------------------
DEEPGRAM_API_KEY=

# --- Stedi (Person C) -----------------------------------------------
# These defaults target `npm run stedi:mock`; replace the key and remove
# STEDI_BASE_URL when switching to the real Stedi test environment.
STEDI_API_KEY=local-mock-key
STEDI_TEST_MODE=true
STEDI_BASE_URL=http://localhost:3100

# Approved live Stedi mock patient. Copy portal values exactly.
DEMO_PATIENT_FIRST_NAME=
DEMO_PATIENT_LAST_NAME=
# Stedi format: YYYYMMDD. The Medplum seed converts it to FHIR YYYY-MM-DD.
DEMO_PATIENT_DATE_OF_BIRTH=
DEMO_PATIENT_MEMBER_ID=
DEMO_PATIENT_TRADING_PARTNER_SERVICE_ID=

# Set to the Patient id printed by `npm run seed` for hosted Medplum.
DEMO_MEDPLUM_PATIENT_ID=
