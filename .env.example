PORT=3000

MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
MEDPLUM_BASE_URL=https://api.medplum.com/

DEEPGRAM_API_KEY=

STEDI_API_KEY=
STEDI_TEST_MODE=true

# Copy these values exactly from Person C's approved Stedi mock patient.
# Do not invent or "temporarily" substitute identity values.
DEMO_PATIENT_FIRST_NAME=
DEMO_PATIENT_LAST_NAME=
# Stedi format: YYYYMMDD. The Medplum seed converts it to FHIR YYYY-MM-DD.
DEMO_PATIENT_DATE_OF_BIRTH=
DEMO_PATIENT_MEMBER_ID=
DEMO_PATIENT_TRADING_PARTNER_SERVICE_ID=

# Set this to the Patient id printed by `npm run seed` when using hosted Medplum.
DEMO_MEDPLUM_PATIENT_ID=
